{ 
    "meta-version": 1,
    "name"          : "Gzz::Readline",
    "perl"          : "6.c",
    "auth":           "zef:grizzlysmit",
    "authors": [
        "Francis Grizzly Smit <grizzly@smit.id.au>"
    ],
    "description"   : "Extension to Gnu Readline to get a prompt with a default value",
    "license": "LGPL-3.0-or-later",
    "version": "0.1.38",
    "perl": "6.d",
    "source-url": "https://github.com/grizzlysmit/gzzReadline.git",
    "support": {
        "bugtracker": "https://github.com/grizzlysmit/gzzReadline/issues",
        "source":     "https://github.com/grizzlysmit/gzzReadline.git",
        "email": "grizzly@smit.id.au"
    },
    "provides": {
        "Gzz::Readline":            "lib/Gzz/Readline.rakumod"
    },
    "resources": [
        "CMakeLists.txt",
        "contrib/postinst.in",
        "debian/final_deb_stuff.sh.in",
        "images/grizzly.png",
        "source/gzz_readline.c",
        "source/gzz_readline.h",
        "source/gzz_readline.pc.in",
        "source/gzz_rlprivate.c",
        "source/gzz_rlprivate.h",
        "docs/Gzz/Readline.1",
        "docs/Gzz/Readline.html",
        "docs/Gzz/Readline.rakudoc",
        "docs/Gzz/README.md"
    ], 
    "bin": {
        "Gzz::Readline.rakudoc": "doc/Gzz/Readline.rakudoc"
    },
    "depends": [
        "Distribution::Builder::Cmake-alt",
        "P5readlink",
        "Pod::To::HTML", 
        "Pod::To::Man",
        "Pod::Load", 
        "Test::Output", 
        "Template::Mustache"
    ],
    "tags": [
        "readline",
        "prompt",
        "edit",
        "prefill",
        "cli",
        "term",
        "terminal",
        "C"
    ],
    "builder": "Distribution::Builder::Cmake-alt",
    "build": {
        "lib"    : "gzz_readline",
        "install": "/usr/local/lib",
        "src-dir": "resources",
        "master-lib-version": "0.0.2",
        "lib-versions": {
            "0": "0.0.2",
            "": "0"
        },
        "source": "source",
        "debug": true
    }
}
